{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tendi.dev/schemas/runtime-meta-schema.json",
  "title": "Tendi Runtime OpenRPC profile",
  "type": "object",
  "required": ["openrpc", "info", "methods", "components", "x-tendi"],
  "properties": {
    "openrpc": { "const": "1.3.2" },
    "info": { "type": "object", "required": ["title", "version"] },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "params", "result", "x-tendi"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "params": {
            "type": "array",
            "maxItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "required", "schema"],
              "properties": {
                "name": { "const": "request" },
                "required": { "const": true },
                "schema": { "type": "object" }
              }
            }
          },
          "result": { "type": "object", "required": ["schema"], "properties": { "schema": { "type": "object" } } },
          "x-tendi": {
            "type": "object",
            "required": ["owner", "wire", "clients", "execution"],
            "properties": {
              "owner": { "enum": ["daemon", "desktop"] },
              "wire": { "enum": ["jsonrpc", "tauri"] },
              "clients": { "type": "array", "items": { "type": "string" } },
              "execution": { "enum": ["read", "write"] },
              "typedHandler": { "type": "boolean" },
              "serializedWrite": { "type": "boolean" },
              "serializedWriteWhen": { "type": "string" },
              "internal": { "type": "boolean" },
              "deprecated": { "type": "boolean" }
            }
          }
        }
      }
    },
    "components": { "type": "object", "required": ["schemas"] },
    "x-tendi": {
      "type": "object",
      "required": ["protocolVersion", "schemaVersion", "events", "transports"],
      "properties": {
        "protocolVersion": { "const": 2 },
        "schemaVersion": { "const": 1 },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "payload", "wire", "revisioned", "replay", "clients"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "payload": { "type": "object" },
              "wire": { "enum": ["sse", "tauri"] },
              "revisioned": { "type": "boolean" },
              "replay": { "type": "boolean" },
              "clients": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "code"],
            "properties": { "kind": { "type": "string" }, "code": { "type": "integer" } }
          }
        },
        "transports": { "type": "array" }
      }
    }
  },
  "additionalProperties": true
}
